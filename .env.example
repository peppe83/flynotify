# ==========================================================================
# flynotify — file di configurazione (template)
#
# USO:
#   1. Copia questo file in ".env"      →   cp .env.example .env   (o copia a mano)
#   2. Compila i valori reali in ".env"
#   3. NON versionare ".env" (aggiungilo a .gitignore). Qui restano solo esempi.
#
# Legenda:   [MVP] serve già per la versione "solo ricerca"
#            [FULL] serve per alert/email/utenti
#            [GUIDE] serve per la scheda-destinazione (§2quater)
# ==========================================================================


# --------------------------------------------------------------------------
# App / server
# --------------------------------------------------------------------------
APP_NAME=flynotify
APP_ENV=development                 # development | production
APP_BASE_URL=http://localhost:8000  # URL pubblico dell'app (usato nei link email)
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR

# Host/porta del server (uvicorn)
HOST=127.0.0.1
PORT=8000

# Default applicativi
DEFAULT_TIMEZONE=Europe/Rome        # fuso orario di default per i nuovi utenti
DEFAULT_CURRENCY=EUR                # valuta di default (ISO 4217)
DEFAULT_LANGUAGE=it


# --------------------------------------------------------------------------
# [MVP] Amadeus — API voli   (vedi Appendice A del documento)
# Chiavi gratuite da https://developers.amadeus.com → My Self-Service Workspace → Create New App
# --------------------------------------------------------------------------
AMADEUS_CLIENT_ID=                  # = "API Key" dell'app Amadeus
AMADEUS_CLIENT_SECRET=              # = "API Secret" dell'app Amadeus
AMADEUS_BASE_URL=https://test.api.amadeus.com   # TEST (gratis). Produzione: https://api.amadeus.com
AMADEUS_TIMEOUT_SECONDS=15
AMADEUS_MAX_RETRIES=3               # retry con backoff su 429/5xx


# --------------------------------------------------------------------------
# Travelpayouts (Aviasales) — secondo provider, copertura low-cost   (vedi §2cinque / Appendice B)
# Gratuito: registrati su https://www.travelpayouts.com → token API + marker (id affiliato)
# --------------------------------------------------------------------------
TRAVELPAYOUTS_TOKEN=                # token API del tuo account Travelpayouts
TRAVELPAYOUTS_MARKER=               # marker (id affiliato) assegnato all'account
TRAVELPAYOUTS_BASE_URL=https://api.travelpayouts.com
TRAVELPAYOUTS_CURRENCY=eur
PROVIDER_PRIMARY_DISCOVERY=travelpayouts   # provider per la scoperta ampia (free)
PROVIDER_PRIMARY_DETAIL=amadeus            # provider per il dettaglio live / ri-validazione


# --------------------------------------------------------------------------
# [FULL] Database MySQL
# Per il solo MVP di ricerca è FACOLTATIVO (si può lasciare vuoto).
# --------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=flynotify
DB_USER=flynotify
DB_PASSWORD=
DB_POOL_SIZE=5


# --------------------------------------------------------------------------
# [FULL] Autenticazione / JWT
# --------------------------------------------------------------------------
JWT_SECRET=change-me-with-a-long-random-string   # firma dei token: stringa lunga e casuale
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30


# --------------------------------------------------------------------------
# [FULL] Email via Gmail (account Google + App Password)   (vedi §8bis)
# Richiede: account Google dedicato con Verifica in due passaggi + "Password per le app" (16 caratteri)
# --------------------------------------------------------------------------
GMAIL_USER=flynotify.alerts@gmail.com   # indirizzo mittente (account dedicato consigliato)
GMAIL_APP_PASSWORD=                     # App Password di 16 caratteri (NON la password dell'account)
EMAIL_FROM_NAME=flynotify
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587                           # 587 = STARTTLS
EMAIL_DAILY_CAP=450                     # limite di sicurezza sotto i ~500/giorno di Gmail free


# --------------------------------------------------------------------------
# [FULL] Scheduler / worker   (lanciato da Windows Task Scheduler, vedi §6bis)
# L'intervallo è PER-UTENTE (users.poll_interval_hours); qui i vincoli globali.
# --------------------------------------------------------------------------
MIN_POLL_INTERVAL_HOURS=2           # minimo che un utente può impostare (protezione quota)
DEFAULT_POLL_INTERVAL_HOURS=6       # valore iniziale per i nuovi utenti
WORKER_LOCK_NAME=flynotify_worker   # nome del GET_LOCK MySQL anti-sovrapposizione
CALL_BUDGET_SOFT_LIMIT=2000         # soglia chiamate/mese oltre cui il worker auto-rallenta
FIRST_CHECK_ON_CREATE=true          # check immediato alla creazione di un alert


# --------------------------------------------------------------------------
# [FULL] Tetti di piano (regole di prodotto per restare nel gratuito)
# --------------------------------------------------------------------------
MAX_USERS=50                        # utenti massimi (beta)
MAX_ALERTS_PER_USER=5
MAX_DATE_OFFSET_DAYS=7              # offset ±X massimo selezionabile nella ricerca


# --------------------------------------------------------------------------
# Feature flag
# --------------------------------------------------------------------------
ENABLE_ALERTS=false                 # [FULL] attiva alert + worker + email
ENABLE_GUIDE=false                  # [GUIDE] attiva la scheda-destinazione
ENABLE_LLM=false                    # [GUIDE] usa Gemini per overview/itinerario (altrimenti testo curato)


# --------------------------------------------------------------------------
# [GUIDE] Scheda destinazione — fonti dati   (§2quater)
# Tutte con tier gratuito. Compilare solo se ENABLE_GUIDE=true.
# --------------------------------------------------------------------------
OPENTRIPMAP_API_KEY=                # POI e dintorni — https://opentripmap.io
TICKETMASTER_API_KEY=               # eventi nelle date — https://developer.ticketmaster.com
# Open-Meteo (clima/meteo) non richiede chiave: https://open-meteo.com
OPENMETEO_BASE_URL=https://api.open-meteo.com

# LLM Google Gemini — chiave gratuita da https://aistudio.google.com (Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash       # modello rapido ed economico per testi brevi

# Memorizzazione della guida (deroga cache circoscritta: NON riguarda i prezzi voli)
GUIDE_STABLE_TTL_DAYS=14            # dati stabili (tipo meta, POI, transfer): TTL lungo
GUIDE_DATED_TTL_HOURS=24           # dati legati alle date (eventi, hotel, meteo): TTL breve
